/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AWS Batch execution profile — configuration only, not yet run on AWS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Required parameters (no defaults; set them for your AWS Batch environment):
      --aws_queue   Batch job queue name        --aws_region  region of the queue / bucket
      -work-dir s3://<bucket>/work              --outdir s3://<bucket>/results/<run>
    Docker images come from quay.io / community.wave.seqera.io exactly as with -profile docker.
----------------------------------------------------------------------------------------
*/

process {
    executor       = 'awsbatch'
    queue          = { params.aws_queue ?: error("Set --aws_queue for -profile awsbatch") }
    resourceLimits = [ cpus: 16, memory: '64.GB', time: '24.h' ]
    errorStrategy  = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries     = 2
}

aws {
    region = params.aws_region ?: 'eu-west-1'   // the nf-core template default; set --aws_region explicitly
    batch {
        cliPath   = params.aws_cli
        maxParallelTransfers = 4
        // spot instances are chosen in the compute environment, not here
    }
    client {
        maxConnections = 20
        uploadStorageClass = 'STANDARD'
    }
}

docker.enabled = true
